*==================== 笔记 09：OCR 在线检测 ====================
dev_close_window ()
path := 'samples/ocr_digits'
dev_open_window (0, 0, 900, 140, 'black', WindowHandle)
*1）读取训练好的分类器
read_ocr_class_mlp (path+'/Model0-9.omc', OCRHandle)
*2）列出文件夹里的所有图片
list_files (path, ['files','follow_links'], ImageFiles)
tuple_regexp_select (ImageFiles, ['\.(bmp|jpg|jpeg)$','ignore_case'], ImageFiles)
*把每张图的识别结果记到文本文件里
open_file ('notes_detect_result.txt', 'output', FileHandle)
if (|ImageFiles| > 0)
    for Index := 0 to |ImageFiles| - 1 by 1
        *3）读取检测图像，提取图像中单个字符区域
        read_image (Image, ImageFiles[Index])
        threshold (Image, Region1, 0, 10)
        connection (Region1, ConnectedRegions)
        select_shape (ConnectedRegions, SelectedRegions, 'area', 'and', 1000, 99999)
        sort_region (SelectedRegions, SortedRegions, 'first_point', 'true', 'column')
        count_obj (SortedRegions, Number)
        *4）使用OCR分类器对区域字符进行分类
        do_ocr_multi_class_mlp (SortedRegions, Image, OCRHandle, Class, Confidence)
        dev_display (Image)
        resultText := ''
        for Number := 1 to Number by 1
            disp_message (WindowHandle, Class[Number-1], 'image', 100, 30+((Number-1)*82), 'green', 'false')
            resultText := resultText + Class[Number-1]
        endfor
        fwrite_string (FileHandle, ImageFiles[Index] + '  ->  ' + resultText)
        fnew_line (FileHandle)
    endfor
endif
close_file (FileHandle)
*5）释放分类器
clear_ocr_class_mlp (OCRHandle)
